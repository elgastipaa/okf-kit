#!/bin/sh
# OKF pre-commit hook — enforcement UNIVERSAL (corre con cualquier herramienta o IA,
# porque es a nivel git, no de un vendor).
#
# Instalación (elegí una):
#   cp templates/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#   # — o, versionable en el repo —
#   mkdir -p .githooks && cp templates/hooks/pre-commit .githooks/ && chmod +x .githooks/pre-commit
#   git config core.hooksPath .githooks
#
# Hace tres cosas:
#   1) Conformidad (BLOQUEA el commit): linta el contenido STAGED de knowledge/.
#   2) Frescura (solo AVISA): si cambió código pero knowledge/ no, lo recuerda.
#   3) Sello (solo AVISA): si un concepto se editó y su `timestamp` quedó igual.
# Para saltarlo puntualmente: git commit --no-verify

BUNDLE="knowledge"
[ -d "$BUNDLE" ] || exit 0

# --- 1. Conformidad sobre lo STAGED (bloqueante) ---
# Copiamos SOLO el contenido staged de knowledge/ a un tempdir y linteamos ahí. El
# working-tree NO se toca (nada de `git stash` → cero riesgo de corromper archivos
# con partial-staging). Se valida exactamente lo que se va a commitear.
# El output del linter solo se muestra si algo falla: un hook que escupe texto en cada
# commit limpio se vuelve ruido que se deja de leer.
if command -v python3 >/dev/null 2>&1 && [ -f scripts/okf_lint.py ]; then
  # Sin verificar, un mktemp que falla (TMPDIR inválido, disco lleno, sandbox de CI) dejaba
  # tmp="" y el --prefix="/" intentaba escribir el bundle en la RAÍZ; el chequeo bloqueante
  # desaparecía sin una sola línea de aviso, al revés que la rama sin python3.
  if ! tmp=$(mktemp -d); then
    echo "OKF: no pude crear un directorio temporal; chequeo de conformidad OMITIDO." >&2
    tmp=""
  fi
  trap '[ -n "$tmp" ] && rm -rf "$tmp"' EXIT
  [ -n "$tmp" ] && git ls-files -- "$BUNDLE" | git checkout-index --prefix="$tmp/" -f --stdin 2>/dev/null
  if [ -n "$tmp" ] && [ -d "$tmp/$BUNDLE" ]; then
    out=$(python3 scripts/okf_lint.py "$tmp/$BUNDLE" 2>&1) || {
      printf '%s\n' "$out" >&2
      echo "OKF: el bundle staged no es conforme (ver arriba). Corregí, o 'git commit --no-verify' para saltar." >&2
      exit 1
    }
  fi
else
  echo "OKF: chequeo de conformidad omitido (sin python3 o sin scripts/okf_lint.py)." >&2
fi

# --- 2. Frescura (aviso, no bloquea) ---
staged=$(git diff --cached --name-only)
echo "$staged" | grep -qE "^$BUNDLE/" && bundle_changed=yes || bundle_changed=no
echo "$staged" | grep -vE "(^$BUNDLE/|\.md$)" | grep -q . && code_changed=yes || code_changed=no
if [ "$code_changed" = yes ] && [ "$bundle_changed" = no ]; then
  echo "OKF: cambió código pero knowledge/ no se tocó. ¿Este cambio amerita actualizar el" >&2
  echo "     contexto (una decisión, un cambio de schema, un gotcha)? Si sí: usá okf-update." >&2
fi

# --- 3. Sello de frescura (aviso, no bloquea) ---
# Un concepto editado sin bumpear su `timestamp` deja el sello MINTIENDO, y eso no es
# cosmético: `okf_stale.py` rankea dónde buscar drift calculando TODAS sus señales desde ese
# valor. Un sello podrido no solo no avisa: envenena la detección del resto.
seals=$(mktemp) || seals=""
if [ -n "$seals" ]; then
  git diff --cached --name-only --diff-filter=M -- "$BUNDLE" | while IFS= read -r f; do
    case "$f" in
      *.md) ;;
      *) continue ;;
    esac
    # index.md / log.md no son conceptos; los `_*` son plantillas o capas efímeras.
    case "$f" in
      */index.md|index.md|*/log.md|log.md|*/_*|_*) continue ;;
    esac
    old=$(git show "HEAD:$f" 2>/dev/null | sed -n 's/^timestamp:[[:space:]]*//p' | head -1)
    new=$(git show ":$f" 2>/dev/null | sed -n 's/^timestamp:[[:space:]]*//p' | head -1)
    # Sin timestamp previo no hay sello que bumpear (el linter ya avisa que falta).
    [ -n "$old" ] || continue
    [ "$old" = "$new" ] && echo "$f" >> "$seals"
  done
  if [ -s "$seals" ]; then
    echo "OKF: estos conceptos se editaron y su \`timestamp\` quedó igual:" >&2
    sed 's/^/       /' "$seals" >&2
    echo "     Bumpealo a la fecha de hoy (ISO 8601). El sello es la base con la que" >&2
    echo "     okf_stale.py rankea el drift: si miente, la señal del bundle entero se degrada." >&2
  fi
  rm -f "$seals"
fi
exit 0
