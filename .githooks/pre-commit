#!/bin/sh
# okf-kit pre-commit — corre el gate propio del kit (selfcheck) antes de cada commit.
# selfcheck es stdlib-only (sin pip) y abarca todo el repo: lintea knowledge/ --strict
# y verifica la consistencia interna (kit_version == VERSION, tokens keep-alive, refs).
# Chequea el working tree (más simple que el snapshot staged que el kit shippea a otros
# repos en templates/hooks/pre-commit, porque selfcheck cruza muchos archivos del repo).
#
#   Activar (una vez por clon):  git config core.hooksPath .githooks
#   Salteo de emergencia:        git commit --no-verify
if command -v python3 >/dev/null 2>&1; then
  if ! python3 scripts/okf_selfcheck.py; then
    echo ""
    echo "✗ okf_selfcheck falló — arreglá lo de arriba o usá 'git commit --no-verify'."
    exit 1
  fi
else
  echo "okf pre-commit: python3 no encontrado; salteando selfcheck."
fi
